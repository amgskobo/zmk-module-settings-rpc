{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc -b && vite build",
    "lint": "eslint . && npm run lint:tests && prettier --check . ../tests/web",
    "preview": "vite preview",
    "generate": "buf generate",
    "test": "buf generate && jest --config ../tests/web/jest.config.ts",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "format": "prettier --write . ../tests/web",
    "lint:tests": "cd .. && node web/node_modules/eslint/bin/eslint.js --config tests/web/eslint.config.mjs tests/web"
  },
  "dependencies": {
    "@cormoran/zmk-studio-react-hook": "github:cormoran/react-zmk-studio#77652d6aca7b1a3d7d165d5fa659da7a89ec9034",
    "@zmkfirmware/zmk-studio-ts-client": "github:cormoran/zmk-studio-ts-client#7c833385c0d7a76e09a5ab7b16a16e5c72c68dac",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.62.1",
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.7.4",
    "run-script-os": "^1.1.6",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5",
    "protobufjs": "7.6.5"
  }
}
